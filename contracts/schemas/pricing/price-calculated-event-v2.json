{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://maliev.com/schemas/pricing/price-calculated-event-v2.json",
    "title": "PriceCalculatedEventV2",
    "description": "Published when a price calculation completes using the v2 fixed-cost allocation model.",
    "allOf": [
        {
            "$ref": "../shared/base-message.json"
        },
        {
            "type": "object",
            "properties": {
                "messageName": {
                    "type": "string",
                    "const": "PriceCalculatedEventV2",
                    "description": "The canonical v2 pricing event name."
                },
                "messageType": {
                    "type": "string",
                    "const": "Event",
                    "description": "The pricing contract message type."
                },
                "messageVersion": {
                    "type": "string",
                    "const": "2.0.0",
                    "description": "The fixed semantic version of this additive pricing contract."
                },
                "publishedBy": {
                    "type": "string",
                    "const": "PricingService",
                    "description": "The service that publishes calculated prices."
                },
                "consumedBy": {
                    "type": "array",
                    "const": [],
                    "description": "The intended consumers; empty until a v2 consumer is implemented."
                }
            },
            "required": [
                "messageName",
                "messageType",
                "messageVersion",
                "publishedBy",
                "consumedBy"
            ]
        }
    ],
    "type": "object",
    "properties": {
        "payload": {
            "type": "object",
            "description": "The complete v2 pricing calculation result.",
            "properties": {
                "pricingAuditId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Unique identifier for the pricing audit record."
                },
                "quotationId": {
                    "type": ["string", "null"],
                    "format": "uuid",
                    "description": "Quotation identifier when the price is linked to a quotation."
                },
                "fileId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Unique identifier for the priced file."
                },
                "customerId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Unique identifier for the customer."
                },
                "materialId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Material used for the pricing calculation."
                },
                "processId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Manufacturing process used for pricing."
                },
                "quantity": {
                    "type": "integer",
                    "description": "Quantity of items priced."
                },
                "inputVolumeCm3": {
                    "type": "number",
                    "description": "Part volume in cubic centimetres used as input."
                },
                "inputSupportVolumeCm3": {
                    "type": "number",
                    "description": "Support material volume in cubic centimetres."
                },
                "inputSurfaceAreaCm2": {
                    "type": "number",
                    "description": "Surface area in square centimetres used as input."
                },
                "strategy": {
                    "type": "string",
                    "description": "Pricing strategy used for the calculation."
                },
                "mlModelVersion": {
                    "type": ["string", "null"],
                    "description": "Machine-learning model version when applicable."
                },
                "confidenceLevel": {
                    "type": "number",
                    "description": "Confidence level of the price calculation from zero to one."
                },
                "pricingConfigurationId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Pricing configuration record used for the calculation."
                },
                "breakdown": {
                    "type": "object",
                    "description": "Detailed cost breakdown with explicit fixed-cost allocation.",
                    "properties": {
                        "materialCost": {
                            "type": "number",
                            "description": "Raw material cost."
                        },
                        "supportCost": {
                            "type": "number",
                            "description": "Support material cost."
                        },
                        "machineTimeCost": {
                            "type": "number",
                            "description": "Machine time cost."
                        },
                        "setupCost": {
                            "type": "number",
                            "description": "Raw setup cost allocated once per priced line."
                        },
                        "fixedDfmSurcharge": {
                            "type": "number",
                            "description": "The setup-derived DFM surcharge allocated once per priced line."
                        },
                        "complexitySurcharge": {
                            "type": "number",
                            "description": "Complexity surcharge excluding the fixed DFM allocation."
                        },
                        "subtotalBeforeMargin": {
                            "type": "number",
                            "description": "Subtotal before margin."
                        },
                        "marginAmount": {
                            "type": "number",
                            "description": "Margin amount added."
                        },
                        "totalPrice": {
                            "type": "number",
                            "description": "Total price after margin."
                        }
                    },
                    "required": [
                        "materialCost",
                        "supportCost",
                        "machineTimeCost",
                        "setupCost",
                        "fixedDfmSurcharge",
                        "complexitySurcharge",
                        "subtotalBeforeMargin",
                        "marginAmount",
                        "totalPrice"
                    ]
                },
                "totalUnitPrice": {
                    "type": "number",
                    "description": "Final calculated unit price."
                },
                "totalPrice": {
                    "type": "number",
                    "description": "Total price including quantity."
                },
                "currency": {
                    "type": "string",
                    "description": "ISO 4217 currency code."
                },
                "validUntil": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Price validity expiry timestamp."
                },
                "calculatedAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Timestamp when the price was calculated."
                },
                "storagePath": {
                    "type": ["string", "null"],
                    "description": "Storage path used as a frontend join key."
                },
                "estimatedLeadTimeDays": {
                    "type": ["integer", "null"],
                    "description": "Estimated production and shipping lead time in days."
                }
            },
            "required": [
                "pricingAuditId",
                "fileId",
                "customerId",
                "materialId",
                "processId",
                "quantity",
                "inputVolumeCm3",
                "inputSupportVolumeCm3",
                "inputSurfaceAreaCm2",
                "strategy",
                "confidenceLevel",
                "pricingConfigurationId",
                "breakdown",
                "totalUnitPrice",
                "totalPrice",
                "currency",
                "validUntil",
                "calculatedAt"
            ]
        }
    },
    "required": ["payload"]
}
